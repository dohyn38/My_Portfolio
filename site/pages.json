{
  "baseURL": "https://dohyn38.github.io/My_Portfolio/",
  "languageCode": "ko-KR",
  "defaultContentLanguage": "ko",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "title": "DOHYEON / PORTFOLIO",
  "menu": {
    "main": [
      { "name": "Projects", "url": "/#projects", "weight": 10 },
      { "name": "About Me", "url": "/about/", "weight": 20 }
    ]
  },
  "params": {
    "defaultTheme": "dark",
    "assets": {
      "favicon": "favicon-moon.png",
      "favicon16x16": "favicon-moon-16.png",
      "favicon32x32": "favicon-moon-32.png",
      "apple_touch_icon": "apple-touch-moon.png"
    }
  }
}