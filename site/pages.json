{
  "baseURL": "https://dohyn38.github.io/My_Portfolio/",
  "languageCode": "ko-KR",
  "defaultContentLanguage": "ko",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "title": "DOHYEON / PORTFOLIO",
  "menu" :{
    "main": [
      {
        "name": "ABOUT ME",
        "url": "/#about",
        "weight": 10
      },
      {
        "name": "INTERESTS & GOALS",
        "url": "/#goals",
        "weight": 20
      },
      {
        "name": "PROJECTS",
        "url": "/#projects",
        "weight": 30
      }
    ]
  },
  "params": {
    "assets": {
      "favicon": "favicon.svg"
    }
  }
}